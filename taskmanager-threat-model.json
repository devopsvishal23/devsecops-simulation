              "threats": [
                {
                  "id": "69815f0b-e25a-4706-a597-edbb52b3746f",
                  "title": "Attacker spoofs user identity",
                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering",
                  "description": "Attacker sends API requests pretending to be a legitimate user. Our app has no authentication — any request is accepted without verifying who sent it.",
                  "mitigation": "Implement JWT token authentication on every endpoint. Validate token signature and expiry on every request.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 1,
                  "score": ""
                },
                {
                  "id": "136b6857-5746-411a-8da0-69161f837971",
                  "title": "Internal system details exposed in error messages",
                  "status": "Open",
                  "severity": "High",
                  "type": "Information disclosure",
                  "description": "The GET /tasks/<id> endpoint returns the database filename and raw SQL query in its 404 error response. This tells an attacker exactly how the backend is structured.",
                  "mitigation": "Return generic error messages to clients. Log detailed errors server-side only. Never expose database names, query strings or stack traces in API responses.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 4,
                  "score": ""
                },
                {
                  "id": "8e6b3f7b-2fea-4eee-835d-4b401ed569e3",
                  "title": "API flood causes service unavailability",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Denial of service",
                  "description": "There is no rate limiting on any endpoint. An attacker can send thousands of requests per second, consuming all server resources and making the API unavailable to legitimate users.",
                  "mitigation": " Implement rate limiting — maximum 100 requests per minute per IP. Return HTTP 429 when limit is exceeded.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 5,
                  "score": ""
                }
              ],
              "trustBoundaryIds": [],
              "threatFrequency": {
                "tampering": 1,
                "informationDisclosure": 1,
                "denialOfService": 1
              }
            },
