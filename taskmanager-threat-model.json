            "id": "514c9fb5-caab-4591-ba26-6e9ac58f1fcd",
            "data": {
              "type": "tm.Process",
              "name": "Flask API",
              "description": "",
              "outOfScope": false,
              "isTrustBoundary": false,
              "reasonOutOfScope": "",
              "hasOpenThreats": true,
              "handlesCardPayment": false,
              "handlesGoodsOrServices": false,
              "isWebApplication": false,
              "privilegeLevel": "",
              "threats": [
                {
                  "id": "2774723c-fd88-4023-be0b-08da7e5c3325",
                  "title": "Any user can access any other user's tasks",
                  "status": "Open",
                  "severity": "High",
                  "type": "Elevation of privilege",
                  "description": "GET /tasks/1 returns task 1 regardless of who is asking. There is no check that the requesting user owns that task. Any user can access, modify or delete any other user's data by changing the ID in the URL. This is IDOR — Insecure Direct Object Reference.",
                  "mitigation": "After authentication is added, verify that task.created_by matches the authenticated user's identity before returning or modifying any task.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 6,
                  "score": ""
                },
                {
                  "id": "fffdc0e2-5573-473a-b862-b9494577add3",
                  "title": "Debug mode exposes stack traces in production",
                  "status": "Open",
                  "severity": "High",
                  "type": "Information disclosure",
                  "description": "Flask is running with debug=True. In production this means any unhandled error returns a full interactive stack trace to the browser, exposing internal code structure, variable values and file paths to any attacker who triggers an error.",
                  "mitigation": "Set debug=False in production. Load via environment variable: app.run(debug=os.environ.get('FLASK_DEBUG', False))",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 7,
                  "score": ""
                },
                {
                  "id": "432b84ed-1d99-40bc-9c8e-cff8c8b525dc",
                  "title": "Hardcoded secret key in source code",
                  "status": "Open",
                  "severity": "Critical",
                  "type": "Information disclosure",
                  "description": "The Flask SECRET_KEY is hardcoded as 'hardcoded-secret-key-123' directly in app.py. Anyone with read access to the source code repository can see this key and use it to forge session tokens.",
                  "mitigation": "Load secret key from environment variable or secrets manager. Never hardcode credentials in source code. Use detect-secrets pre-commit hook to catch this before commit.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 8,
                  "score": ""
                }
              ],
              "threatFrequency": {
                "spoofing": 0,
                "tampering": 0,
                "repudiation": 0,
                "informationDisclosure": 2,
                "denialOfService": 0,
                "elevationOfPrivilege": 1
              }
            }
