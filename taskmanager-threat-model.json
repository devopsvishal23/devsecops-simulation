                {
                  "id": "ce4a46f8-5146-42e1-925f-cbd6b3bbe856",
                  "title": "SQL Injection via request body",
                  "status": "Open",
                  "severity": "Critical",
                  "type": "Tampering",
                  "description": " Attacker sends a malicious title field like ' OR '1'='1 in the POST /tasks body. The app inserts this directly into a SQL query without sanitisation, allowing the attacker to manipulate the database.",
                  "mitigation": "Use parameterised queries throughout. Never concatenate user input into SQL strings.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 2,
                  "score": ""
                },
                {
                  "id": "fa5c5adb-0456-4488-84ed-b00d0bcf5bad",
                  "title": "No audit log of user actions",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Repudiation",
                  "description": "The app has no audit logging. A user can create, update or delete tasks and completely deny doing so. There is no record of who did what and when.",
                  "mitigation": "Add structured audit logging on all create, update and delete operations. Log user identity, action, timestamp and affected resource.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 3,
                  "score": ""
                }
              ],
